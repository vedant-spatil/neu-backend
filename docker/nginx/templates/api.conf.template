# nginx in front of the API (plan.md section 23). The official nginx image fills in ${API_DOMAIN}.

# HTTP: Let's Encrypt challenges, and redirect everything else to HTTPS.
server {
    listen 80;
    server_name ${API_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: the API. Certificate from Let's Encrypt (scripts/issue_cert.sh).
server {
    listen 443 ssl;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # The HI-Small CSV is about 475 MB and the import endpoint streams it.
    client_max_body_size 600m;
    # Case runs and imports can take a while.
    proxy_read_timeout 300s;

    # Live updates (server-sent events): no buffering, and a long timeout for the held connection.
    # CSV upload: nginx forwards the body as it arrives instead of writing all ~475 MB to disk first.
    location /api/imports {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        client_body_timeout 600s;
        proxy_read_timeout 300s;
    }

    location /api/stream {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
