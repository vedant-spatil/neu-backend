# Copy to .env and fill in. Never commit .env. Names and placeholders only (plan.md section 23).

# --- LLM. LLM_PROVIDER picks the provider: groq or bedrock. Model names are IDs for that provider. ---
# Groq free tier: about 8,000 tokens a minute per model.
LLM_PROVIDER=groq
GROQ_API_KEY=
BEDROCK_API_KEY=
BEDROCK_REGION=ap-south-1
LLM_MODEL_HEAVY=
LLM_MODEL_LIGHT=

# --- Databases. Production: set real values. ---
POSTGRES_PASSWORD=POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://aml:aml@localhost:5432/aml

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=NEO4J_PASSWORD

YENTE_URL=http://localhost:8000

PII_ENCRYPTION_KEY=

# --- Auth. Production: generate a real JWT_SECRET_KEY (32+ characters). ---
JWT_SECRET_KEY=replace-with-32-plus-random-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Runtime ---
# dev locally. prod on EC2: the API refuses the dev JWT secret and Neo4j password when APP_ENV=prod.
APP_ENV=dev
TRIAGE_THRESHOLD=0.6
# Frontend origin(s), comma separated. Add http://localhost:5173 for local dev. Each Vercel preview URL needs adding too.
CORS_ORIGINS=https://neu-frontend-eight.vercel.app

# --- EC2 deploy only (docker-compose.prod.yml, scripts/issue_cert.sh) ---
# API_DOMAIN must point at the instance's Elastic IP before issuing the certificate.
API_DOMAIN=api.example.com
LE_EMAIL=you@example.com

# Admin observability page (CloudWatch Logs group the API writes to; empty = not configured)
OBSERVABILITY_LOG_GROUP=
OBSERVABILITY_REGION=
